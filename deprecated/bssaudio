import numpy as np
import torch
import torchaudio
import pyroomacoustics as pra
import os

# Function to generate and save a stereo mixed audio variation
def generate_variation(speech_file, variation_id, room_dim, absorption, speech_pos, noise_pos, noise_type, noise_scale, sample_rate=16000, duration=None):
    # Load speech audio
    speech_wave, sr = torchaudio.load(speech_file)
    if sr != sample_rate:
        resampler = torchaudio.transforms.Resample(sr, sample_rate)
        speech_wave = resampler(speech_wave)
    speech = speech_wave.squeeze().numpy()  # Assume mono, convert to numpy

    # Truncate or pad to duration if specified (otherwise use full length)
    if duration:
        target_len = int(sample_rate * duration)
        if len(speech) > target_len:
            speech = speech[:target_len]
        else:
            speech = np.pad(speech, (0, target_len - len(speech)))

    # Generate noise based on type
    noise_len = len(speech)
    if noise_type == 'white':
        noise = np.random.randn(noise_len) * noise_scale
    elif noise_type == 'brown':
        noise = np.cumsum(np.random.randn(noise_len)) / np.arange(1, noise_len + 1)  # Simple brown noise approximation
        noise = (noise / np.max(np.abs(noise))) * noise_scale  # Normalize and scale
    elif noise_type == 'pink':
        white = np.random.randn(noise_len)
        fft_white = np.fft.rfft(white)
        freq = np.fft.rfftfreq(noise_len, 1/sample_rate)
        pink_filter = 1 / np.sqrt(np.maximum(freq, 1e-10))  # Avoid div by zero
        fft_pink = fft_white * pink_filter
        noise = np.fft.irfft(fft_pink, n=noise_len)
        noise = (noise / np.max(np.abs(noise))) * noise_scale

    # Create room with given dimensions and absorption
    room = pra.ShoeBox(room_dim, fs=sample_rate, materials=pra.Material(absorption), max_order=10)

    # Add sources
    room.add_source(speech_pos, signal=speech)
    room.add_source(noise_pos, signal=noise)

    # Stereo microphone array (fixed positions, e.g., 10cm apart in the center)
    center_x, center_y, center_z = np.mean(room_dim) / 2, np.mean(room_dim[1:]) / 2, 1.5
    mic_positions = np.c_[[center_x - 0.05, center_x + 0.05], [center_y, center_y], [center_z, center_z]]
    room.add_microphone_array(mic_positions)

    # Simulate the room acoustics
    room.simulate()

    # Get the stereo mixed signal
    mix_signals = room.mic_array.signals  # [2, samples]
    mix = torch.from_numpy(mix_signals).float()

    # Save the mixed stereo audio
    output_dir = 'mixed_variations'
    os.makedirs(output_dir, exist_ok=True)
    output_file = f'{output_dir}/variation_{variation_id}_{os.path.basename(speech_file)}'
    torchaudio.save(output_file, mix, sample_rate)
    print(f'Saved variation {variation_id}: {output_file}')

